{
  "name": "magpie-tokentracker",
  "version": "0.1.0",
  "private": true,
  "description": "在 magpie 窗口里追踪 TokenTracker 的 token 用量：今天 / 7 天 / 30 天的 token 与花费，按编程工具和模型拆分。",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "lib",
    "page",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "tokentracker",
    "usage",
    "tokens",
    "cost",
    "dashboard"
  ],
  "license": "MIT",
  "author": "jerryjiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryjiao/magpie-tokentracker.git"
  },
  "bugs": {
    "url": "https://github.com/jerryjiao/magpie-tokentracker/issues"
  },
  "homepage": "https://github.com/jerryjiao/magpie-tokentracker#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jerryjiao"
  },
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "magpie": {
    "name": "TokenTracker",
    "summary": {
      "en": "Token usage tracked by TokenTracker: tokens and cost for today, 7 days and 30 days, split by coding tool and model, with an hourly/daily trend. Runs a zero-dependency local service that reads this machine's TokenTracker data over its loopback API.",
      "zh": "TokenTracker 追踪的 token 用量：今天 / 7 天 / 30 天的 token 与花费，按编程工具和模型拆分，带小时级与每日趋势。自带零依赖本机服务，通过回环接口读本机 TokenTracker 的数据。"
    },
    "page": {
      "title": "TokenTracker",
      "titles": {
        "zh": "TokenTracker 用量",
        "en": "TokenTracker"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3491,
        "option": "port"
      }
    },
    "permissions": [],
    "options": {
      "port": 3491,
      "tokentrackerPort": 7680,
      "autoStart": true,
      "command": "",
      "timeZone": ""
    }
  }
}
